# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Local dev: start Postgres with `docker compose up -d` then use the default below.
# Railway: the DATABASE_URL variable is set automatically by the Postgres plugin.
DATABASE_URL=postgres://cms:cms_dev_password@localhost:5432/lightweight_cms

# Upload storage path (for Railway volumes, set to e.g. /data/uploads)
# This directory should contain an "images" subfolder used by the media pipeline.
UPLOADS_DIR=./public/uploads

# Security
SESSION_SECRET=change-this-secret-key-in-production
# Set to 'true' when behind HTTPS in production
FORCE_HTTPS=false

# Setup token for initial admin creation or emergency password reset
# Generate with: openssl rand -base64 32
# Only needed during setup; can be removed after first admin is created
SETUP_TOKEN=your-secure-setup-token-here

# Password hashing (higher = slower but more secure, default 12)
# BCRYPT_ROUNDS=12

# Site Configuration
SITE_HOST=localhost:3000
# Canonical base URL used for static generation, Stripe redirects, and og:image
# Set this in production to your public HTTPS domain (no trailing slash)
SITE_URL=https://www.example.com
# Used as sender name in transactional emails (contact, orders, bookings)
# SITE_TITLE=My Site

# Google Analytics measurement ID (leave blank to disable)
# GA_ID=G-XXXXXXXXXX

# Email Configuration (Contact Form via Resend HTTPS API)
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Sender address must belong to a domain verified in Resend
CONTACT_EMAIL_FROM=noreply@example.com
CONTACT_EMAIL_FROM_NAME=Contact Form

# Email recipient for contact forms
CONTACT_EMAIL_TO=admin@example.com

# Admin email for order and booking notifications (can be same as CONTACT_EMAIL_TO)
ADMIN_EMAIL=admin@example.com

# Send confirmation email to visitor (true/false)
SEND_CONFIRMATION_EMAIL=true

# Cloudflare Turnstile (bot protection for contact form)
# Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE (optional — leave blank to use local filesystem)
# When S3_BUCKET is set, uploaded images are stored in the S3-compatible bucket
# instead of the local uploads directory.  Works with:
#   • AWS S3        — set region and leave endpoint blank
#   • Cloudflare R2 — set endpoint to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   • MinIO         — set endpoint to http://minio:9000 and S3_FORCE_PATH_STYLE=true
#   • Backblaze B2  — set endpoint to https://s3.<region>.backblazeb2.com
#   • DigitalOcean Spaces — set endpoint to https://<region>.digitaloceanspaces.com
# ──────────────────────────────────────────────────────────────────────────────
# S3_BUCKET=my-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                    # custom endpoint URL (non-AWS providers)
# S3_FORCE_PATH_STYLE=false       # set true for MinIO / path-style endpoints
# S3_PUBLIC_URL=                  # base URL for serving files (e.g. https://cdn.example.com)
#                                 # If omitted, defaults to https://<bucket>.s3.<region>.amazonaws.com


# STRIPE (optional — required for M5 Shop feature)
# ──────────────────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...


# FEATURE FLAGS
# Opt-out model: omit a variable (or set it to anything other than "false"/"0")
# to keep the feature ENABLED. Set to "false" to disable it on this deployment.
# Changing these requires a redeploy. Super-admin users bypass all flags.
# ──────────────────────────────────────────────────────────────────────────────

# Block types — hide specific blocks from the page/article builder for editors
# FEATURE_BLOCK_HERO=false
# FEATURE_BLOCK_RICH_TEXT=false
# FEATURE_BLOCK_ENCART_PRINCIPAL=false
# FEATURE_BLOCK_ACCROCHE=false
# FEATURE_BLOCK_PIN_GRID=false
# FEATURE_BLOCK_NUMBERED_CARDS=false
# FEATURE_BLOCK_QUESTION_REPONSE=false
# FEATURE_BLOCK_LEAD_MAGNET=false
# FEATURE_BLOCK_CONTACT_FORM=false
# FEATURE_BLOCK_SHOP_PRODUCT=false       # requires M5 shop milestone
# FEATURE_BLOCK_APPOINTMENT_BOOKING=false # requires appointments milestone

# Admin sections — hide entire sections from the admin nav
# FEATURE_SECTION_BLOG=false
# FEATURE_SECTION_INSTAGRAM=false
# FEATURE_SECTION_SHOP=false             # requires M5 shop milestone
# FEATURE_SECTION_APPOINTMENTS=false     # requires M5 appointments milestone

# Public routes / features
# FEATURE_PUBLIC_CONTACT=false           # disables contact form submission endpoint
# FEATURE_PUBLIC_RSS=false               # disables /feed.xml
# FEATURE_PUBLIC_SITEMAP=false           # disables /sitemap.xml

